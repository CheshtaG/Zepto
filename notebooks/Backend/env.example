# Copy to .env and fill in locally (never commit .env).

# Screenshots + file cache root (instamart/, blinkit/, zepto/, cache/)
COMPARE_DATA_DIR=/Users/cheshtagupta17/Data - Cheshta/Projects/Zepto/data

# Google AI Studio / Gemini — used for Instamart price-from-screenshot when DOM has no price,
# and for the optional full quantity pass below.
COMPARE_GOOGLE_API_KEY=

# When COMPARE_ENABLE_GEMINI_QUANTITY=0, a single-image Gemini call still tries to read Instamart’s
# first-card price from the fallback screenshot (cheap). Set to 0 to disable that too.
COMPARE_ENABLE_GEMINI_INSTAMART_PRICE_FALLBACK=1

# Enable the slow Gemini quantity/vision pass (all three platform images).
# Default is disabled to make the app feel fast; set to 1 if you explicitly want quantity normalization.
COMPARE_ENABLE_GEMINI_QUANTITY=0

# Default model (override if Google renames the endpoint)
# Prefer gemini-2.0-flash for vision; the app falls back to other ids if this fails.
COMPARE_GEMINI_MODEL=gemini-2.0-flash

# Same-SKU alignment: after the first search on each app, Gemini may suggest one unified search
# string and trigger a second pass on all three (requires COMPARE_GOOGLE_API_KEY).
COMPARE_ENABLE_CROSS_PLATFORM_MATCH=1
COMPARE_GEMINI_MATCH_MODEL=gemini-2.0-flash-lite

# How many list items to compare at the same time (each uses 3 parallel browsers)
COMPARE_JOB_MAX_CONCURRENT_ITEMS=2

# --- Instamart when Gemini fails ---
# OCR fallback uses the Tesseract *binary* (separate from Python’s pytesseract package).
# macOS:   brew install tesseract
# Optional if tesseract is not on PATH:
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
